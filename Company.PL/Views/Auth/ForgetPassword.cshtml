@model ForgetPasswordDto
@{
    ViewData["Title"] = "ForgetPassword";
    Layout = "~/Views/Shared/_Auth.cshtml";
}

<div class="main-agileinfo">
	<div class="agileits-top">
		<div asp-validation-summary="ModelOnly"></div>
        <form method="post" id="resetForm">
            <input class="text" asp-for="Email" placeholder="Email" required />
            <input id="emailBtn" type="submit" value="Send Email" />
            <input id="smsBtn" type="submit" value="Send SMS" />
        </form>
	</div>
@section Scripts {
        <script>
            const form = document.getElementById("resetForm");
            const emailBtn = document.getElementById("emailBtn");
            const smsBtn = document.getElementById("smsBtn");

            emailBtn.addEventListener("click", function () {
                form.action = '@Url.Action("SendResetPasswordEmail")';
            });

            smsBtn.addEventListener("click", function () {
                form.action = '@Url.Action("SendResetPasswordSms")';
            });
        </script>
}




