@model List<Department>

@{
    ViewData["Title"] = "All Departments";
}

<div class="container mt-4">
    <h1>All Departments</h1>
    <a asp-action="Create" asp-controller="Departments" class="btn btn-primary mb-3">Create New Department</a>

    <div class="row justify-content-center align-items-center">
        <div class="col-md-8">
            <input type="text" id="DepSearchInp" class="form-control mb-3" placeholder="Search By Name..." />
        </div>
    </div>

    <div id="departmentsTableContainer">
        @await Html.PartialAsync("PartialViews/_DepartmentsTablePartial", Model)
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#DepSearchInp').on('keyup', function () {
                var searchValue = $(this).val();

                $.ajax({
                    url: '/Departments/Search', // must match controller action
                    type: 'GET',
                    data: { searchInp: searchValue },
                    success: function (result) {
                        $('#departmentsTableContainer').html(result);
                    },
                    error: function (xhr, status, error) {
                        console.error("Error:", xhr.responseText || error);
                        $('#departmentsTableContainer').html('<p class="text-danger">Error loading departments.</p>');
                    }
                });
            });
        });
    </script>
}
