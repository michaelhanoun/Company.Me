@model List<RoleDto>
@{
    ViewData["Title"] = "Index";
}

<h1>All Roles</h1>
<br />
<br />
<a asp-action="Create" class="btn btn-primary">Create New Role</a>
<br />
<div class="row justify-content-center align-items-center mt-5">
    <form class="row col-8 offset-2" asp-action="Index">
        <div class="col-8">
            <input type="text" name="searchInp" class="form-control" placeholder="Search By Name" id="DepSearchInp" />
        </div>
        <div class="col-4">
            <input type="submit" class="btn btn-success" value="search" />
        </div>
    </form>
</div>
<br />
@if (@Model.Count > 0)
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th> Name </th>
                <th>Details</th>
                <th>Update</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var role in Model)
            {
                <tr>
                    <td>@role.Name</td>
                    <partial name="_ButtonsPartial" model="@role.Id" />
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="mt-4 alert alert-danger">
        <h3>There is No Roles :(</h3>
    </div>
}

