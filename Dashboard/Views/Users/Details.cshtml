@model UserDetailsDto
@{
    ViewData["Title"] = "Details";
}
<h1>Details</h1>

<br />
<br />

<div>
    <div class="form-group">
        <label class="col-form-label" asp-for="UserName"></label>
        <input class="form-control" asp-for="UserName" readonly />
    </div>
    <div class="form-group">
        <label class="col-form-label" asp-for="FName"></label>
        <input class="form-control" asp-for="FName" readonly />
    </div>
    <div>
        <label class="col-form-label" asp-for="LName"></label>
        <input class="form-control" asp-for="LName" readonly />
    </div>
    @foreach(var role in Model.Roles)
{
    <div>
         <span class="badge bg-primary">@role</span>
    </div>
}
<a asp-action="Update" asp-route-id="@ViewData["id"]" class="btn btn-primary mt-4">Update</a>
    <a asp-action="Index" class="btn btn-light mt-4">Back to List</a>
</div>