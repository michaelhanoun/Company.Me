@model List<UserDto>
@{
    ViewData["Title"] = "Index";
}

<h1>All Users</h1>
<br />
<br />
<br />
<div class="row justify-content-center align-items-center mt-5">
    <form class="row col-8 offset-2" asp-action="Index">
        <div class="col-8">
            <input type="text" name="searchInp" class="form-control" placeholder="Search By Name" id="searchInp" />
        </div>
        <div class="col-4">
            <input type="submit" class="btn btn-success" value="search" />
        </div>
    </form>
</div>
<br />
@if (@Model.Count > 0)
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th> Id </th>
                <th> User Name </th>
                <th> First Name </th>
                <th> Last Name </th>
                <th> Roles </th>
                <th>Details</th>
                <th>Update</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Id</td>
                    <td>@user.UserName</td>
                    <td>@user.FName</td>
                    <td>@user.LName</td>
                    <td>
                        @foreach(var role in user.Roles)
                        {
                            <span class="badge bg-primary">@role</span>
                        }
                    </td>
                    <partial name="_ButtonsPartial" model="@user.Id" />
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="mt-4 alert alert-danger">
        <h3>There is No Users :(</h3>
    </div>
}


